{
  "Logging": {
    "LogLevel": {
      "Default": "Debug"
    },
    "NLog": {
      "RemoveLoggerFactoryFilter": true
    }
  },
  "DocFxHelper": {
    "ShowTips": true
  },
  "NLog": {
    "autoReload": true,
    "autoShutdown": true,
    "throwConfigExceptions": true,
    "internalLogLevel": "Info",
    "internalLogFile": "${BaseDir}/logs/nlog-${shortdate}.log",
    "targets": {
      "log2file": {
        "type": "File",
        "fileName": "${BaseDir}/logs/docfxhelper.cli-${shortdate}.log"
      },
      "log2console": {
        "type": "ColoredConsole",
        "layout": "${message}"
      }
    },
    "rules": [
      {
        "logger": "*",
        "minLevel": "Info",
        "writeTo": "log2console"
      },
      {
        "logger": "*",
        "minLevel": "Debug",
        "writeTo": "log2file"
      }
    ]
  }
}
